# Shaheen Global Cloud — Environment Variables
# Copy this file to .env and fill in your values.

# Application
APP_NAME=Shaheen Global Cloud
APP_VERSION=0.2.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shaheen
REDIS_URL=redis://localhost:6379/0

# Security
API_KEY=dev-api-key-change-me
SECRET_KEY=dev-secret-key-change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Infrastructure
DAGGER_MODULE_PATH=../dagger
TOFU_WORKDIR=../infrastructure/environments/production

# Provider Configuration
# Options: mock, linode
PROVIDER_TYPE=mock

# Linode Provider (only required when PROVIDER_TYPE=linode)
# Get your API token from: https://cloud.linode.com/profile/tokens
LINODE_API_TOKEN=

# Linode Region (default: us-east)
# Available: us-east, us-west, eu-west, ap-south, ap-southeast, ca-central
LINODE_REGION=us-east
